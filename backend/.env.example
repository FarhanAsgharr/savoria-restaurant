# ─────────────────────────────────────────────────────────────
# Backend environment variables (copy to `.env` for local dev)
# ─────────────────────────────────────────────────────────────

# Django secret key — generate a strong random value in production.
SECRET_KEY=django-insecure-dev-only-change-me

# Debug mode — MUST be False in production.
DEBUG=True

# Comma-separated list of allowed hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──
# Leave DATABASE_URL empty in development to use SQLite.
# In production set it to your managed Postgres connection string, e.g.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ── CORS / CSRF ──
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ──
# Public URL of the customer site (Admin "VIEW SITE" link points here).
FRONTEND_URL=http://localhost:3000

# ── Email (admin password reset) ──
# Dev default prints emails to the server console. For production, switch to
# SMTP by setting EMAIL_BACKEND and the EMAIL_* / DEFAULT_FROM_EMAIL values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Savoria <no-reply@savoria.local>

# ── Localization ──
TIME_ZONE=UTC

# ── Logging ──
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# ── Production hardening (ignored while DEBUG=True) ──
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ── Throttling ──
ANON_THROTTLE_RATE=120/min
